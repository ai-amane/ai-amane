# コピーして .env にリネームして使います（.env が無くても動きます）

# ===== ElevenLabs =====
# エージェントID（画面の設定欄から入れてもOK）
ELEVENLABS_AGENT_ID=
# 非公開エージェントの接続と、使用量（クレジット）の表示に使います。
# 権限: ElevenLabs Agents = 書き込み（署名付きURLの発行に convai_write が必要）/ User = 読み取り（使用量表示用）
ELEVENLABS_API_KEY=

# ===== 作業の委任（Codex / Claude Code CLI） =====
# CLI が作業してよいフォルダ（既定: このフォルダの workspace）
TASK_WORKDIR=
# 軽い作業 / 重い作業に使うエンジン: codex-fast | codex | claude-opus | claude-sonnet（Codex を入れていない場合は LIGHT_ENGINE=claude-sonnet）
LIGHT_ENGINE=codex-fast
HEAVY_ENGINE=claude-opus
# 振り分け方法: auto（Laya→無ければエージェントの判断→ルール）| laya | hint | rules
ROUTER=auto
LAYA_URL=http://127.0.0.1:3940
# Laya の確信度がこれ未満なら重い作業として扱う
LAYA_MIN_CONFIDENCE=0.6

# Claude Code の権限モード: acceptEdits（ファイル編集のみ自動許可）| auto | bypassPermissions（全部許可・非推奨）
CLAUDE_PERMISSION_MODE=acceptEdits
# Codex のサンドボックス: read-only | workspace-write | danger-full-access
CODEX_SANDBOX=workspace-write
# Codex のモデルを固定したい場合（空なら config.toml の設定）
CODEX_MODEL=
# CLI の場所（PATH に無い場合だけ）
CODEX_BIN=
CLAUDE_BIN=

TASK_TIMEOUT_SEC=900
MAX_PARALLEL_TASKS=2

# ===== VOICEVOX モード（頭は常駐の Claude Code） =====
VOICEVOX_URL=http://127.0.0.1:50021
# 感情豊かな声の AivisSpeech（無料・VOICEVOX と同じ使い方）を使うときは、AivisSpeech を入れて、ここを次のようにする
# （既定のポートは 10101。VOICEVOX_AUTOSTART=1 なら AivisSpeech のエンジンを起動する）
# VOICEVOX_URL=http://127.0.0.1:10101
# 1 にすると start.bat で VOICEVOX も起動する（見つからなければ VOICEVOX_PATH に run.exe か VOICEVOX.exe の場所を書く。Mac は VOICEVOX.app の場所）
VOICEVOX_AUTOSTART=0
VOICEVOX_PATH=
# エンジン（run.exe）を起動するときに GPU を使うか（Mac では使わない）
VOICEVOX_GPU=1
# 会話用のモデル: haiku（速い）| sonnet（賢いが少し遅い）
#  返事までの時間の目安（この PC での計測。話し終わり → 声が出るまで）: haiku 約 2.7 秒 / sonnet 約 3.4 秒
BRAIN_MODEL=haiku
# 会話中に使ってよいツール（空ならツールなし）
BRAIN_TOOLS=WebSearch
# 0 で思考なし（返事が速い）
BRAIN_THINKING_TOKENS=0
# この分数だけ会話がなければ Claude Code を止める（会話の続きを忘れる）。待受中は止めたあとすぐ起動し直す
BRAIN_IDLE_MIN=20

# ===== ローカル音声認識（stt/stt_server.py。start.bat が一緒に起動します） =====
# 音声認識サーバーは、ここに書いたポートで待ち受けます
STT_URL=http://127.0.0.1:3941
# 0 にすると start.bat で音声認識サーバーを起動しない（start-stt.bat で別に動かす場合など）
STT_AUTOSTART=1
# Python のコマンド（py ランチャーを使う場合は py。Mac の start.command は空なら .venv を作って使う）
PYTHON_BIN=
# reazonspeech（既定・CPUで速い。短い発話は数百ms）| whisper（GPU。1発話あたり一定時間かかる）
STT_ENGINE=reazonspeech
# ReazonSpeech が使う CPU スレッド数（空なら自動）
STT_THREADS=
# 声がこの秒数より短い音は無視する（物音に反応しすぎるなら大きく、短い返事を拾わないなら小さく）
STT_MIN_SPEECH=0.3
# 「呼びかけた人の声だけを聞く」で、その人の声とみなす似ている度合い（0〜1）。
# 自分の声まで聞き流されるなら小さく（0.4 など）、テレビや家族の声を拾うなら大きく（0.5 など）。
# 黒いウィンドウの [stt] 声紋 の行に、区間ごとの値（✓ 聞いた / ✗ 聞き流した）が出ます
STT_SPEAKER_THRESHOLD=0.45
# ↓ここから下は STT_ENGINE=whisper のときだけ使う
# 日本語特化の kotoba-whisper（既定）。ほか large-v3-turbo / medium / small
STT_MODEL=kotoba-tech/kotoba-whisper-v2.0-faster
# auto | cuda | cpu
STT_DEVICE=auto
# 空なら起動時に float16 / int8_float16 / int8 を測って一番速いものを使う
STT_COMPUTE=
# 1 = 速さ優先、5 = 精度優先
STT_BEAM=1
# auto = 発話の長さに合わせて処理窓を縮める（速い）。精度が落ちると感じたら 15
STT_CHUNK=auto
# 1 = Whisper 側でも無音除去（雑音の誤認識が多いとき）
STT_VAD=0

# ===== 画面への資料表示 =====
# 作業フォルダ以外にも表示してよいフォルダ（セミコロン区切り）
SHOW_DIRS=

# ===== iPad・スマホから使う（家の Wi-Fi の中だけ） =====
# 1 にすると、リビングの iPad などから https://この PC の IP アドレス:LAN_PORT で使えます
# 最初に一度だけ、証明書のインストールとペアリング（PC の画面に出る 6 桁の番号を入れる）が必要です。手順は docs/advanced.md
LAN_ACCESS=0
LAN_PORT=3942

# ===== 追加機能（plugins フォルダ。作り方は docs/plugins.md） =====
# 使わない追加機能の名前（カンマ区切り。例: timer）
PLUGINS_OFF=

# ===== その他 =====
# AI の名前（呼びかけの言葉は画面の設定で決めます）
AI_NAME=あまね
# AI からの呼ばれ方（例: 田中さん）
USER_NAME=
PORT=3939
OPEN_BROWSER=1
